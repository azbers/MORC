{%- comment -%}
  Line icons, 24 px grid, 1.5 stroke. Usage: render 'icon', name: 'search'
  Decorative by default (aria-hidden). Give the button around it a label.
{%- endcomment -%}
{%- liquid
  assign cls = class | default: 'icon'
-%}
