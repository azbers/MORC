{%- comment -%} Journal card. Input: article. Reading time from the article's own word count (200 words a minute, at least 1). {%- endcomment -%}
{%- liquid
  assign words = article.content | strip_html | strip_newlines | split: ' ' | size
  assign mins = words | divided_by: 200 | floor
  if mins < 1
    assign mins = 1
  endif
-%}
<article class="article-card">
  <a class="media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: widths: '450, 675, 900', sizes: '(min-width: 1100px) 33vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}{%- endif -%}</a>
  <p class="article-card__meta">{% if article.tags.size > 0 %}<span>{{ article.tags.first | replace: '-', ' ' | capitalize | escape }}</span>{% endif %}<span>{{ 'blog.reading_time' | t: count: mins }}</span></p>
  <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
  <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
  <a class="link-arrow" href="{{ article.url }}" aria-label="{{ 'blog.read_article_label' | t: title: article.title | escape }}">{{ 'blog.read_article' | t }}{% render 'icon', name: 'arrow-right' %}</a>
</article>
