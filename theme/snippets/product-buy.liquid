{%- comment -%}
  Purchase block shared by the product page and quick view: colour, size, size guide link, stock,
  Add to bag, and the data product.js needs. Input: product, sid (unique id), context ('main' or 'quick').
  Colour and size come from the product's real variants. No size is chosen for the buyer.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign colour_pos = 0
  assign size_pos = 0
  for o in product.options_with_values
    assign on = o.name | downcase
    if on contains 'colo'
      assign colour_pos = o.position
    elsif on contains 'size'
      assign size_pos = o.position
    endif
  endfor
  assign low_at = settings.low_stock_at | default: 2
  assign guide_url = settings.size_guide_url | default: settings.page_size | default: '/pages/policies#size-guide'
  assign form_id = 'ProductForm-' | append: sid
-%}
<div class="buy" data-product data-sid="{{ sid }}" data-context="{{ context }}" data-url="{{ product.url }}">
  {%- form 'product', product, data-product-form: '', novalidate: 'novalidate', id: form_id -%}
    <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
    {%- if colour_pos > 0 -%}
      {%- assign ci = colour_pos | minus: 1 -%}{%- assign co = product.options_with_values[ci] -%}
      <fieldset class="option" data-option="{{ colour_pos }}" aria-labelledby="OptC-{{ sid }}">
        <div class="option__head"><legend id="OptC-{{ sid }}">{{ co.name | escape }}: <span class="chosen" data-chosen>{{ co.selected_value | escape }}</span></legend></div>
        <div class="colour-list">
          {%- for v in co.values -%}
            {%- liquid
              assign hex = '#cccccc'
              for tag in product.tags
                if tag contains 'swatch:'
                  assign pair = tag | remove_first: 'swatch:' | split: '='
                  if pair[0] == v
                    assign hex = pair[1]
                  endif
                endif
              endfor
            -%}
            <input type="radio" id="opt-{{ sid }}-c-{{ forloop.index }}" name="option{{ colour_pos }}" value="{{ v | escape }}"{% if v == co.selected_value %} checked{% endif %}>
            <label for="opt-{{ sid }}-c-{{ forloop.index }}"><span class="swatch" style="--sw: {{ hex | escape }}" aria-hidden="true"></span>{{ v | escape }}</label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endif -%}
    {%- if size_pos > 0 -%}
      {%- assign sx = size_pos | minus: 1 -%}{%- assign so = product.options_with_values[sx] -%}
      <fieldset class="option" data-option="{{ size_pos }}" data-size-option aria-labelledby="OptS-{{ sid }}">
        <div class="option__head">
          <legend id="OptS-{{ sid }}">{{ so.name | escape }}<span class="chosen" data-chosen></span></legend>
          <a class="size-guide-link" href="{{ guide_url }}" data-open="SizeGuide" aria-haspopup="dialog">{{ 'product.size_guide' | t }}</a>
        </div>
        <div class="size-grid" role="radiogroup" aria-labelledby="OptS-{{ sid }}" aria-describedby="SizeError-{{ sid }}" data-size-grid>
          {%- for v in so.values -%}
            <input type="radio" id="opt-{{ sid }}-s-{{ forloop.index }}" name="option{{ size_pos }}" value="{{ v | escape }}" required>
            <label for="opt-{{ sid }}-s-{{ forloop.index }}">{{ v | remove: 'EU ' | escape }}<span class="visually-hidden"> {{ v | escape }}</span><span class="visually-hidden" data-sold-label hidden>, {{ 'product.sold_out' | t }}</span></label>
          {%- endfor -%}
        </div>
        <p class="field-error" id="SizeError-{{ sid }}" data-size-error hidden>{% render 'icon', name: 'alert' %}{{ 'product.choose_size' | t }}</p>
      </fieldset>
    {%- endif -%}
    <noscript>
      <div class="field"><label for="VariantSelect-{{ sid }}">{{ 'product.choose_option' | t }}</label>
      <select class="select" id="VariantSelect-{{ sid }}" name="id">{% for v in product.variants %}<option value="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{{ v.title }}{% unless v.available %} ({{ 'product.sold_out' | t }}){% endunless %}</option>{% endfor %}</select></div>
    </noscript>
    <p class="stock-line" data-stock aria-live="polite"></p>
    <input type="hidden" name="quantity" value="1">
    <button class="button button--full" type="submit" data-add{% unless product.available %} disabled{% endunless %}>{% if product.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
    <p class="field-error" data-form-error role="alert" hidden></p>
  {%- endform -%}

  {%- comment -%} price and payment split for each price this product has, so changing colour or size swaps it without a second calculation {%- endcomment -%}
  {%- assign prices = product.variants | map: 'price' | uniq -%}
  {%- for pr in prices -%}<template data-deposit-for="{{ pr }}">{% render 'deposit-summary', total: pr, context: 'product' %}</template>{%- endfor -%}
  {%- assign seen = '' -%}
  {%- for v in product.variants -%}{%- capture key -%}{{ v.price }}-{{ v.compare_at_price | default: 0 }}{%- endcapture -%}{%- unless seen contains key -%}{%- assign seen = seen | append: '|' | append: key | append: '|' -%}<template data-price-for="{{ key }}">{% render 'price', product: product, variant: v, size: 'large' %}</template>{%- endunless -%}{%- endfor -%}
  <script type="application/json" data-product-json>
  {"handle":{{ product.handle | json }},"title":{{ product.title | remove_first: 'DAUR ' | json }},"lowAt":{{ low_at | json }},"sizePos":{{ size_pos }},"colourPos":{{ colour_pos }},"t":{"in":{{ 'product.in_stock' | t | json }},"low":{{ 'product.low_stock' | t | json }},"out":{{ 'product.sold_out' | t | json }},"add":{{ 'product.add' | t | json }},"unavailable":{{ 'product.unavailable' | t | json }}},
  "variants":[{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"qty":{% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity | default: 0 }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
  </script>
</div>
