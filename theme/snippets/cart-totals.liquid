{%- comment -%} Code field, totals and the payment split. Used in the cart drawer and the bag page. {%- endcomment -%}
<details class="cart-code"{% if cart.discount_codes.size > 0 %} open{% endif %}>
  <summary>{{ 'cart.code_title' | t }}</summary>
  <form data-code-form novalidate>
    <label class="visually-hidden" for="CartCode-{{ sid }}">{{ 'cart.code_label' | t }}</label>
    <input class="input" id="CartCode-{{ sid }}" name="discount" autocomplete="off" placeholder="{{ 'cart.code_placeholder' | t }}" aria-describedby="CartCodeMsg-{{ sid }}">
    <button class="button button--secondary" type="submit">{{ 'cart.code_apply' | t }}</button>
  </form>
  <div id="CartCodeMsg-{{ sid }}" aria-live="polite">
    {%- if cart.discount_codes.size > 0 -%}
    <div class="cart-code__applied">
      {%- for d in cart.discount_codes -%}
        <span class="chip">{{ d.code | escape }}{% unless d.applicable %} <span class="muted">({{ 'cart.code_not_applicable' | t }})</span>{% endunless %}<button type="button" data-code-remove="{{ d.code | escape }}" aria-label="{{ 'cart.code_remove' | t: code: d.code | escape }}">{% render 'icon', name: 'close' %}</button></span>
      {%- endfor -%}
    </div>
    {%- for d in cart.discount_codes -%}{%- unless d.applicable -%}<p class="field-error" style="margin-top: var(--s-2)">{% render 'icon', name: 'alert' %}{{ 'cart.code_invalid' | t: code: d.code | escape }}</p>{%- endunless -%}{%- endfor -%}
    {%- endif -%}
  </div>
</details>
<div class="cart-summary">
  <div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
  {%- for d in cart.cart_level_discount_applications -%}
    <div class="cart-summary__row cart-summary__discount"><span>{{ d.title | escape }}</span><span>-{{ d.total_allocated_amount | money }}</span></div>
  {%- endfor -%}
  <div class="cart-summary__row"><span>{{ 'cart.delivery' | t }}</span><span>{{ settings.delivery_price_text | default: 'Free' }}</span></div>
  <div class="cart-summary__row cart-summary__row--total"><span>{{ 'cart.total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
</div>
{%- render 'deposit-summary', total: cart.total_price, context: 'cart' -%}
