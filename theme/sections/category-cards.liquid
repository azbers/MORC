{%- comment -%} Home: category discovery. Four cards, whole card is the link. 4 columns desktop, 2 tablet and phone. {%- endcomment -%}
<section class="section" aria-labelledby="CatTitle-{{ section.id }}">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <div><h2 id="CatTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}</div>
    </div>
    <ul class="cat-cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign href = block.settings.link | default: c.url | default: routes.all_products_collection_url
          assign title = block.settings.title | default: c.title
          assign img = block.settings.image | default: c.image
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="cat-card" href="{{ href }}">
            <span class="media media--portrait">{% render 'site-image', image: img, key: block.settings.test_key, need: block.settings.need, sizes: '(min-width: 990px) 25vw, 50vw', alt: title %}</span>
            <span class="cat-card__label">{{ title | escape }}{% render 'icon', name: 'arrow-right' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Category cards",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your pair." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Footwear for the way you move." }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Name (leave empty to use the collection name)" },
      { "type": "url", "id": "link", "label": "Link (leave empty to use the collection)" },
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "A real DAUR photograph, portrait 4:5." },
      { "type": "text", "id": "test_key", "label": "Test photo key (development only)" },
      { "type": "text", "id": "need", "label": "Placeholder note", "default": "Category photograph needed" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Category cards" }]
}
{% endschema %}
