<div class="page-width not-found">
  <div style="color:var(--c-espresso);width:160px;margin:0 auto var(--s-8)">{% render 'logo' %}</div>
  <h1>{{ shop.password_message | default: 'Opening soon.' | escape }}</h1>
  {%- form 'storefront_password' -%}
    <div class="field" style="max-width:360px;margin:var(--s-8) auto 0"><label for="Password">{{ 'general.password' | t }}</label><input class="input" type="password" name="password" id="Password" autocomplete="current-password"></div>
    {%- if form.errors -%}<p class="field-error" style="justify-content:center">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    <button class="button" type="submit">{{ 'general.enter' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
