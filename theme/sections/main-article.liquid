{%- comment -%}
  Journal article. Breadcrumb, topic, H1, byline, published and (when changed later) updated dates,
  featured image, a table of contents built from the article's own H2 headings when the guide is long,
  the article, share, related guides (same topic first) and related pairs (the collection named by the
  topic tag, or the product list in the article field custom.products). Links inside the article that
  point to a guide not yet published are shown as plain text (see core.js), so readers never land on a
  missing page.
{%- endcomment -%}
{%- liquid
  assign topic = article.tags.first
  assign byline = section.settings.byline | default: shop.name
  assign words = article.content | strip_html | split: ' ' | size
  assign mins = words | divided_by: 200 | floor
  if mins < 1
    assign mins = 1
  endif
  assign pub = article.published_at | date: '%Y-%m-%d'
  assign upd = article.updated_at | date: '%Y-%m-%d'
  assign rel_products = article.metafields.custom.products.value
  if rel_products == blank and topic != blank
    assign th = topic | handleize
    assign rel_products = collections[th].products
  endif
-%}
<article class="page-width article">
  {%- render 'breadcrumbs' -%}
  <header class="page-head read-width">
    {%- if topic -%}<p class="eyebrow"><a href="{{ blog.url }}/tagged/{{ topic | handleize }}">{{ topic | replace: '-', ' ' | capitalize | escape }}</a></p>{%- endif -%}
    <h1>{{ article.title | escape }}</h1>
    <p class="caption article__meta">{{ 'blog.by' | t: author: byline }} · <time datetime="{{ pub }}">{{ article.published_at | date: '%-d %B %Y' }}</time>{% if upd > pub %} · {{ 'blog.updated' | t }} <time datetime="{{ upd }}">{{ article.updated_at | date: '%-d %B %Y' }}</time>{% endif %} · {{ 'blog.reading_time' | t: count: mins }}</p>
  </header>
  {%- if article.image -%}<div class="media media--landscape article__image">{%- assign ai_alt = article.image.alt | default: article.title -%}{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: ai_alt }}</div>{%- endif -%}
  <div class="article__layout">
    {%- comment -%}
      Contents list for longer guides (3 or more H2 headings and over 700 words), built here in the
      page from the guide's own headings so nothing moves once the page has loaded.
    {%- endcomment -%}
    {%- liquid
      assign parts = article.content | split: '<h2'
      assign toc_items = ''
      assign body = ''
      for part in parts
        if forloop.first
          assign body = part
          continue
        endif
        assign head = part | split: '</h2>' | first
        assign head_text = '<h2' | append: head | append: '</h2>' | strip_html | strip
        if head contains 'id="'
          assign hid = head | split: 'id="' | last | split: '"' | first
          assign body = body | append: '<h2' | append: part
        else
          assign hid = 'part-' | append: forloop.index0
          assign body = body | append: '<h2 id="' | append: hid | append: '"' | append: part
        endif
        assign head_esc = head_text | escape
        assign toc_items = toc_items | append: '<li><a href="#' | append: hid | append: '">' | append: head_esc | append: '</a></li>'
      endfor
      assign h2_count = parts.size | minus: 1
    -%}
    {%- if h2_count >= 3 and words > 700 -%}
    <nav class="article__toc" aria-labelledby="Toc-{{ section.id }}" data-toc>
      <p class="info__nav-title" id="Toc-{{ section.id }}">{{ 'blog.contents' | t }}</p>
      <ol data-toc-list>{{ toc_items }}</ol>
    </nav>
    {%- endif -%}
    <div class="rte" data-article-body data-blog="{{ blog.handle }}" data-live="{% for a in blog.articles limit: 250 %}{{ a.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}">{{ body }}</div>
  </div>
  <div class="article__share read-width">
    <p class="info__nav-title">{{ 'blog.share' | t }}</p>
    <button class="button button--small button--secondary" type="button" data-share="{{ shop.url }}{{ article.url }}" data-share-title="{{ article.title | escape }}">{% render 'icon', name: 'share' %}{{ 'blog.share_link' | t }}</button>
    <a class="button button--small button--secondary" href="https://wa.me/?text={{ article.title | append: ' ' | append: shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}WhatsApp<span class="visually-hidden"> {{ 'general.opens_whatsapp' | t }}</span></a>
  </div>
</article>
{%- assign shown = 0 -%}
{%- capture related -%}
  {%- for a in blog.articles -%}
    {%- if a.id != article.id and topic and a.tags contains topic and shown < 3 -%}<li>{% render 'article-card', article: a %}</li>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- for a in blog.articles -%}
    {%- if a.id != article.id and shown < 3 -%}{%- unless topic and a.tags contains topic -%}<li>{% render 'article-card', article: a %}</li>{%- assign shown = shown | plus: 1 -%}{%- endunless -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="section" aria-labelledby="RelA-{{ section.id }}">
  <div class="page-width"><h2 id="RelA-{{ section.id }}">{{ 'blog.related' | t }}</h2><ul class="article-cards">{{ related }}</ul></div>
</section>
{%- endif -%}
{%- if rel_products != blank and rel_products.size > 0 -%}
<section class="section section--muted" aria-labelledby="RelP-{{ section.id }}">
  <div class="page-width"><h2 id="RelP-{{ section.id }}">{{ 'blog.pairs' | t }}</h2>
    <ul class="product-grid product-grid--4">{%- for p in rel_products limit: 4 -%}<li>{% render 'product-card', product: p %}</li>{%- endfor -%}</ul>
  </div>
</section>
{%- endif -%}
<div style="height: var(--section-y)"></div>
{% schema %}
{ "name": "Article", "settings": [
  { "type": "text", "id": "byline", "label": "Byline", "default": "DAUR Supply", "info": "Who wrote it. Use a real name or the brand, never an invented person." }
] }
{% endschema %}
