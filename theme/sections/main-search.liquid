{%- comment -%} Search results: products as cards, pages and journal guides as links. {%- endcomment -%}
{%- paginate search.results by 24 -%}
<div class="page-width">
  <header class="page-head">
    <h1>{% if search.performed %}{{ 'search.results_for' | t: count: search.results_count, terms: search.terms | escape }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:var(--s-2);max-width:560px;margin-top:var(--s-6)">
      <label class="visually-hidden" for="SearchPage">{{ 'search.label' | t }}</label>
      <input class="input" id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="muted">{{ 'search.no_results' | t: terms: search.terms | escape }}</p>
      <p><a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'header.shop_all' | t }}</a></p>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'collection.products_heading' | t }}</h2>
      <ul class="product-grid product-grid--4">
        {%- for item in search.results -%}{%- if item.object_type == 'product' -%}<li>{% render 'product-card', product: item %}</li>{%- endif -%}{%- endfor -%}
      </ul>
      <ul class="search-suggest__links" style="margin-top:var(--s-10)">
        {%- for item in search.results -%}{%- unless item.object_type == 'product' -%}<li><a href="{{ item.url }}">{{ item.title | escape }}</a> <span class="caption">{% if item.object_type == 'article' %}{{ 'search.journal' | t }}{% else %}{{ 'search.page' | t }}{% endif %}</span></li>{%- endunless -%}{%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav aria-label="{{ 'general.pagination' | t }}"><ul class="pagination">{%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a></li>{%- endif -%}{%- if paginate.next -%}<li><a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a></li>{%- endif -%}</ul></nav>{%- endif -%}
    {%- endif -%}
  {%- endif -%}
</div>
<div style="height: var(--section-y)"></div>
{%- endpaginate -%}
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
