{%- comment -%}
  Size guide page body: a drawn measuring diagram (heel against the wall, longest toe, measuring direction,
  centimetre scale) and the size chart. The chart is read from the "Size guide" part of the Policies page,
  the one source the bag drawer and product pages also use, so the numbers never exist in two versions.
{%- endcomment -%}
{%- liquid
  assign src = pages[section.settings.page]
  assign chart = ''
  if src.content contains '<h2>Size guide</h2>'
    assign part = src.content | split: '<h2>Size guide</h2>' | last | split: '<h2>' | first
    if part contains '<table'
      assign chart = part | split: '</table>' | first | split: '<table' | last | prepend: '<table' | append: '</table>'
    endif
  endif
-%}
<section class="section" aria-labelledby="Measure-{{ section.id }}">
  <div class="page-width size-page">
    <figure class="size-diagram">
      <svg viewBox="20 0 290 290" role="img" aria-labelledby="SDt-{{ section.id }} SDd-{{ section.id }}">
        <title id="SDt-{{ section.id }}">{{ section.settings.diagram_title | escape }}</title>
        <desc id="SDd-{{ section.id }}">{{ section.settings.diagram_desc | escape }}</desc>
        <rect x="40" y="20" width="250" height="250" fill="#FFFFFF" stroke="#8D8981"/>
        <path d="M44 150c0-38 22-62 60-70 22-5 46-6 72-4 30 2 58 6 80 14 20 7 28 18 28 32 0 15-10 25-30 31-24 7-52 10-82 11-30 1-58 0-78-6-32-9-50-30-50-8Z" fill="#F7F6F2" stroke="#171717" stroke-width="2"/>
        <circle cx="252" cy="128" r="12" fill="none" stroke="#171717" stroke-width="1.5"/>
        <line x1="44" y1="205" x2="44" y2="232" stroke="#9B1C1C" stroke-width="2"/>
        <line x1="264" y1="128" x2="264" y2="232" stroke="#9B1C1C" stroke-width="2" stroke-dasharray="4 4"/>
        <line x1="48" y1="224" x2="258" y2="224" stroke="#9B1C1C" stroke-width="2"/>
        <path d="M258 224l-10-5v10z" fill="#9B1C1C"/><path d="M48 224l10-5v10z" fill="#9B1C1C"/>
        <g font-family="Inter, Arial, sans-serif" font-size="13" fill="#171717">
          <text x="50" y="62">{{ 'size_guide.d_heel' | t }}</text>
          <text x="200" y="104">{{ 'size_guide.d_toe' | t }}</text>
          <text x="96" y="216">{{ 'size_guide.d_length' | t }}</text>
        </g>
        <g stroke="#63605B">
          {%- for i in (0..25) -%}{%- assign x = i | times: 8 | plus: 48 -%}{%- assign m = i | modulo: 5 -%}<line x1="{{ x }}" y1="250" x2="{{ x }}" y2="{% if m == 0 %}262{% else %}256{% endif %}"/>{%- endfor -%}
          <line x1="48" y1="250" x2="248" y2="250"/>
        </g>
        <g font-family="Inter, Arial, sans-serif" font-size="11" fill="#63605B"><text x="45" y="276">0</text><text x="122" y="276">10</text><text x="200" y="276">20 cm</text></g>
      </svg>
      <figcaption class="caption">{{ section.settings.diagram_caption | escape }}</figcaption>
    </figure>
    <div class="size-chart">
      <h2 id="Measure-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro | escape }}</p>{%- endif -%}
      {%- if chart != '' -%}
        <div class="table-scroll" role="region" aria-label="{{ section.settings.heading | escape }}" tabindex="0">{{ chart }}</div>
      {%- else -%}
        <p>{{ 'size_guide.missing' | t }}</p>
      {%- endif -%}
      {%- if section.settings.after != blank -%}<div class="rte">{{ section.settings.after }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Size chart and diagram",
  "settings": [
    { "type": "text", "id": "page", "label": "Page that holds the size chart (handle)", "default": "policies", "info": "The chart is read from its \"Size guide\" heading, so it is kept in one place." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size chart" },
    { "type": "text", "id": "intro", "label": "One line", "default": "Men's sizes. Find your EU size by the length of your foot." },
    { "type": "richtext", "id": "after", "label": "Under the chart", "default": "<p>Sizes available differ by pair. Each product page shows the sizes in stock.</p>" },
    { "type": "text", "id": "diagram_title", "label": "Diagram title (read by screen readers)", "default": "How to measure your foot" },
    { "type": "text", "id": "diagram_desc", "label": "Diagram description", "default": "A foot traced on a sheet of paper. The length is measured in a straight line from the back of the heel to the tip of the longest toe, in centimetres." },
    { "type": "text", "id": "diagram_caption", "label": "Caption", "default": "Measure in a straight line from the back of the heel to the tip of your longest toe." }
  ],
  "presets": [{ "name": "Size chart and diagram" }]
}
{% endschema %}
