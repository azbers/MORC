{%- comment -%}
  Information page opening: breadcrumb, eyebrow, the page's one H1, a short supporting line, optional
  "last updated" date, up to two buttons and an optional editorial photo (real photo, or a clearly
  marked placeholder). Links accept "@faq" style page keys (see snippet link-to).
{%- endcomment -%}
{%- liquid
  assign crumb = section.settings.crumb | default: section.settings.heading
  assign has_image = section.settings.show_image
-%}
<section class="page-hero{% if has_image %} page-hero--image{% endif %}" aria-labelledby="H-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.parent != blank -%}
      {%- capture parent_url -%}{% render 'link-to', to: section.settings.parent_link %}{%- endcapture -%}
      {%- render 'breadcrumbs', title: crumb, parent_title: section.settings.parent, parent_url: parent_url -%}
    {%- else -%}
      {%- render 'breadcrumbs', title: crumb -%}
    {%- endif -%}
    <div class="page-hero__grid">
      <div class="page-hero__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 id="H-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.subheading != blank -%}<p class="page-hero__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="page-hero__lead">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.updated != blank -%}<p class="caption page-hero__updated">{{ section.settings.updated | escape }}</p>{%- endif -%}
        {%- if section.settings.cta1 != blank or section.settings.cta2 != blank -%}
        <p class="page-hero__actions">
          {%- if section.settings.cta1 != blank -%}<a class="button" href="{% render 'link-to', to: section.settings.cta1_link %}">{{ section.settings.cta1 | escape }}</a>{%- endif -%}
          {%- if section.settings.cta2 != blank -%}<a class="button button--secondary" href="{% render 'link-to', to: section.settings.cta2_link %}">{{ section.settings.cta2 | escape }}</a>{%- endif -%}
        </p>
        {%- endif -%}
      </div>
      {%- if has_image -%}
      <div class="page-hero__media media media--landscape">{% render 'site-image', image: section.settings.image, key: section.settings.test_key, need: section.settings.need, sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager' %}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Page opening",
  "settings": [
    { "type": "text", "id": "crumb", "label": "Breadcrumb name", "info": "Defaults to the heading." },
    { "type": "text", "id": "parent", "label": "Parent page in the breadcrumb (optional)" },
    { "type": "text", "id": "parent_link", "label": "Parent page link", "info": "A path, or a page key such as @shipping." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (the page's H1)", "default": "Page heading" },
    { "type": "text", "id": "subheading", "label": "Supporting line" },
    { "type": "richtext", "id": "text", "label": "Short introduction" },
    { "type": "text", "id": "updated", "label": "Last updated line", "info": "For policy pages, for example: Last updated 5 November 2026." },
    { "type": "text", "id": "cta1", "label": "Button 1" },
    { "type": "text", "id": "cta1_link", "label": "Button 1 link", "info": "A path such as /collections/men, or @faq, @size, @whatsapp." },
    { "type": "text", "id": "cta2", "label": "Button 2" },
    { "type": "text", "id": "cta2_link", "label": "Button 2 link" },
    { "type": "checkbox", "id": "show_image", "label": "Show an editorial photo", "default": false },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Genuine DAUR footwear or craft only." },
    { "type": "text", "id": "need", "label": "Placeholder note", "default": "Real DAUR photograph needed" },
    { "type": "text", "id": "test_key", "label": "Test photo key (development only)" }
  ],
  "presets": [{ "name": "Page opening" }]
}
{% endschema %}
