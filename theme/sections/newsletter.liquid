{%- comment -%}
  Home: newsletter through Shopify's customer form, which subscribes the email to marketing. The form cannot be sent
  until the visitor ticks the consent box themselves (browser check, plus a clear message from core.js); nothing is
  ticked for them. Success and error messages come from Shopify.
{%- endcomment -%}
<section class="section section--muted" aria-labelledby="Nl-{{ section.id }}">
  <div class="page-width newsletter" data-reveal>
    <div>
      <h2 id="Nl-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'Newsletter', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--ok" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %}{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert" id="NlErr-{{ section.id }}">{% render 'icon', name: 'alert' %}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <div class="newsletter__row">
          <label class="visually-hidden" for="NlEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input class="input" id="NlEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NlErr-{{ section.id }}"{% endif %}>
          <button class="button" type="submit">{{ section.settings.button | escape }}</button>
        </div>
        <label class="checkbox newsletter__consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required data-consent-required> <span>{{ 'newsletter.consent' | t }} <a href="{{ shop.privacy_policy.url | default: '/pages/policies#privacy-policy' }}">{{ 'newsletter.privacy' | t }}</a></span></label>
        <p class="field-error" id="NlConsentErr-{{ section.id }}" data-consent-error hidden>{% render 'icon', name: 'alert' %}{{ 'newsletter.consent_needed' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop." },
    { "type": "text", "id": "text", "label": "Text", "default": "New pairs, useful guides and the occasional offer. Nothing unnecessary." },
    { "type": "text", "id": "button", "label": "Button", "default": "Join DAUR" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
