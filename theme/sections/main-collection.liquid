{%- comment -%} Collection page, Phase 2 build: breadcrumb, title, short introduction, count, sort, grid, pagination. Filters and editorial content arrive in Phase 3. {%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
<div class="page-width">
  {%- render 'breadcrumbs' -%}
  <header class="collection-head">
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description | strip_html | truncatewords: 60 }}</div>{%- endif -%}
  </header>
  <div class="collection-bar">
    <p style="margin:0">{{ 'collection.count' | t: count: collection.products_count }}</p>
    <form method="get" data-sort-form>
      <label class="visually-hidden" for="SortBy">{{ 'collection.sort' | t }}</label>
      <select class="select" id="SortBy" name="sort_by" onchange="this.form.submit()">
        {%- for o in collection.sort_options -%}<option value="{{ o.value }}"{% if o.value == collection.sort_by or collection.sort_by == blank and o.value == collection.default_sort_by %} selected{% endif %}>{{ o.name | escape }}</option>{%- endfor -%}
      </select>
      <noscript><button class="button button--small" type="submit">{{ 'collection.apply' | t }}</button></noscript>
    </form>
  </div>
  {%- if collection.products.size > 0 -%}
  <ul class="product-grid product-grid--4">
    {%- for p in collection.products -%}
      <li>{% if forloop.index <= 4 %}{% render 'product-card', product: p, loading: 'eager' %}{% else %}{% render 'product-card', product: p %}{% endif %}</li>
    {%- endfor -%}
  </ul>
  {%- else -%}
  <p class="muted">{{ 'collection.empty' | t }}</p>
  <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}
  {%- if paginate.pages > 1 -%}
  <nav aria-label="{{ 'general.pagination' | t }}">
    <ul class="pagination">
      {%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a></li>{%- endif -%}
      {%- for part in paginate.parts -%}
        <li>{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}</li>
      {%- endfor -%}
      {%- if paginate.next -%}<li><a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a></li>{%- endif -%}
    </ul>
  </nav>
  {%- endif -%}
</div>
<div style="height: var(--section-y)"></div>
{%- endpaginate -%}
{% schema %}
{ "name": "Collection", "settings": [ { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 } ] }
{% endschema %}
