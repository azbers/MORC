<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F7F6F2">
{%- render 'meta-tags' -%}
{{ 'manrope-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'inter-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'daur.css' | asset_url | stylesheet_tag }}
{%- comment -%} Editorial entrance motion only when allowed; a timer shows everything if the script never runs. {%- endcomment -%}
<script>(function(d){try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('js-reveal');setTimeout(function(){if(!window.DAUR||!window.DAUR.ready)d.classList.remove('js-reveal')},2500)}}catch(e){}d.classList.add('js')})(document.documentElement);</script>
{%- if settings.clarity_id != blank %}
<script>(function(c,l,a,r,i){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};function go(){var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";l.head.appendChild(t)}function later(){(c.requestIdleCallback||function(f){setTimeout(f,1500)})(go,{timeout:4000})}if(l.readyState==='complete')later();else c.addEventListener('load',later)})(window,document,"clarity","script",{{ settings.clarity_id | strip | json }});</script>
{%- endif %}
{% render 'structured-data', product: product, collection: collection, blog: blog, article: article, page: page %}
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
<a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">
{{ content_for_layout }}
</main>
{% sections 'footer-group' %}
{% section 'cart-drawer' %}
<div class="overlay" data-overlay></div>
{%- if settings.whatsapp_float and template.name != 'cart' -%}{% render 'whatsapp-button' %}{%- endif -%}
{% render 'consent-banner' %}
<div class="toast" role="status" aria-live="polite" data-toast></div>
<script>window.DAUR={routes:{root:{{ routes.root_url | json }},cart:{{ routes.cart_url | json }},cartAdd:{{ routes.cart_add_url | json }},cartChange:{{ routes.cart_change_url | json }},cartUpdate:{{ routes.cart_update_url | json }},suggest:{{ routes.predictive_search_url | json }}},t:{added:{{ 'cart.added' | t | json }},error:{{ 'cart.error' | t | json }},chooseSize:{{ 'product.choose_size' | t | json }},updated:{{ 'cart.updated' | t | json }},searching:{{ 'search.searching' | t | json }},results:{{ 'search.results_count' | t | json }},codeEmpty:{{ 'cart.code_empty' | t | json }},copied:{{ 'general.copied' | t | json }}}};</script>
<script src="{{ 'core.js' | asset_url }}" defer></script>
{%- if template.name == 'product' %}<script src="{{ 'product.js' | asset_url }}" defer></script>{% endif %}
<script type="speculationrules">{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/cart*","/checkout*","/checkouts/*","/account*","/*?*add*","/discount/*"]}}]},"eagerness":"moderate"}]}</script>
</body>
</html>
