  {
    "name": "Payment (Care deposit)",
    "settings": [
      {
        "type": "paragraph",
        "content": "One rule for the whole site. Each pair is a limit and a deposit in rupees. A limit includes its own amount: 3000:500 means order totals up to and including Rs 3,000 send Rs 500. Above the last limit the full amount is paid in advance. The deposit is part of the total; the rest is paid to the rider."
      },
      {
        "type": "checkbox",
        "id": "advance_required",
        "label": "Ask for an advance before dispatch",
        "default": true
      },
      {
        "type": "text",
        "id": "advance_tiers",
        "label": "Limits and deposits",
        "default": "3000:500, 8000:1000, 15000:1500",
        "info": "Approved by the owner on 6 Nov 2026."
      }
    ]
  },
