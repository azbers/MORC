{%- comment -%}
  DAUR Supply packing slip with prices, for the Shopify Order Printer app.
  Built for the Order Printer PDF renderer: table layout, plain colour values, inline styles only.
  Fonts try the store Files (morc-*.woff2) first and fall back to Helvetica or Arial.
{%- endcomment -%}
<style type="text/css">
@font-face { font-family: 'DAUR Display'; font-weight: 500; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-space-grotesk-500.woff2') format('woff2'); }
@font-face { font-family: 'DAUR Display'; font-weight: 700; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-space-grotesk-700.woff2') format('woff2'); }
@font-face { font-family: 'DAUR Mono'; font-weight: 400; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-jetbrains-mono-400.woff2') format('woff2'); }
@font-face { font-family: 'DAUR Mono'; font-weight: 700; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-jetbrains-mono-700.woff2') format('woff2'); }
@font-face { font-family: 'DAUR Body'; font-weight: 400; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-inter-400.woff2') format('woff2'); }
@font-face { font-family: 'DAUR Body'; font-weight: 600; src: url('https://cdn.shopify.com/s/files/1/0837/0798/6174/files/morc-inter-600.woff2') format('woff2'); }
@page { size: A4; margin: 12mm; }
</style>
{%- assign units = 0 -%}{%- for li in line_items -%}{%- assign units = units | plus: li.quantity -%}{%- endfor -%}
<div style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;color:#2A1C14;font-size:12px;line-height:1.5;max-width:720px;margin:0 auto;">

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;"><tr>
  <td style="padding:0;vertical-align:top;vertical-align:bottom;"><svg width="220" height="66" viewBox="-22 0 464 140" fill="#2A1C14" xmlns="http://www.w3.org/2000/svg" aria-label="DAUR Supply" style="display:block;"><g transform="skewX(-12)" fill-rule="evenodd"><path d="M0,0 H50 A50,50 0 0 1 50,100 H0 Z M27,25 H50 A25,25 0 0 1 50,75 H27 Z"/><path transform="translate(110 0)" d="M0,100 L36,0 H72 L108,100 H79 L54,28 L29,100 Z"/><path transform="translate(226 0)" d="M0,0 H27 V52 A23,23 0 0 0 73,52 V0 H100 V52 A50,48 0 0 1 0,52 Z"/><path transform="translate(340 0)" d="M0,0 H62 A31,31 0 0 1 80,56 L102,100 H71 L51,62 H27 V100 H0 Z M27,20 H61 A11,11 0 0 1 61,42 H27 Z"/></g><g fill="#B0843F"><rect x="-12" y="124" width="262" height="3"/><text x="266" y="133" font-family="DAUR Mono, Menlo, Consolas, monospace" font-weight="700" font-size="22" letter-spacing="15.5">SUPPLY</text></g></svg></td>
  <td style="padding:0;vertical-align:top;vertical-align:bottom;text-align:right;">
    <div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:6px;">SUPPLY MANIFEST</div>
    <div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:30px;line-height:1;letter-spacing:-0.5px;color:#2A1C14;">PACKING SLIP</div>
  </td>
</tr></table>
<div style="height:14px;"></div><svg width="100%" height="4" viewBox="0 0 100 4" preserveAspectRatio="none" style="display:block;"><rect width="84" height="4" fill="#2A1C14"/><rect x="84" width="16" height="4" fill="#B0843F"/></svg>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:14px;"><tr>
  <td style="padding:0;vertical-align:top;width:25%;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;">ORDER</div><div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:15px;margin-top:3px;">{{ order.name }}</div></td>
  <td style="padding:0;vertical-align:top;width:25%;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;">ORDER DATE</div><div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:500;font-size:14px;margin-top:3px;">{{ order.created_at | date: "%d %b %Y" }}</div></td>
  <td style="padding:0;vertical-align:top;width:20%;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;">TOTAL PAIRS</div><div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:500;font-size:14px;margin-top:3px;">{{ units }}</div></td>
  <td style="padding:0;vertical-align:top;width:30%;text-align:right;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;">PAYMENT</div><div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:500;font-size:14px;margin-top:3px;">{% if order.financial_status == 'paid' %}Paid online{% else %}Cash on delivery{% endif %}</div></td>
</tr></table>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:18px;border-top:1px solid #E2D6C6;border-bottom:1px solid #E2D6C6;"><tr>
  <td style="padding:0;vertical-align:top;width:50%;padding:14px 16px 14px 0;font-size:12px;line-height:1.5;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:6px;">SHIP TO</div>{%- if order.shipping_address -%}<div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;color:#2A1C14;margin:0 0 3px;">{{ order.shipping_address.name }}</div>{{ order.shipping_address.address1 }}{% if order.shipping_address.address2 != blank %}, {{ order.shipping_address.address2 }}{% endif %}<br>{{ order.shipping_address.city }}{% if order.shipping_address.province != blank %}, {{ order.shipping_address.province }}{% endif %} {{ order.shipping_address.zip }}<br>{{ order.shipping_address.country }}{% if order.shipping_address.phone != blank %}<br>Tel. {{ order.shipping_address.phone }}{% endif %}{%- else -%}<div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;color:#2A1C14;margin:0 0 3px;">{{ customer.name }}</div>No shipping address{%- endif -%}</td>
  <td style="padding:0;vertical-align:top;width:50%;padding:14px 0 14px 16px;border-left:1px solid #E2D6C6;font-size:12px;line-height:1.5;color:#7A6A5C;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:6px;">BILL TO</div>{%- if order.billing_address -%}<div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;color:#2A1C14;margin:0 0 3px;">{{ order.billing_address.name }}</div>{{ order.billing_address.address1 }}{% if order.billing_address.address2 != blank %}, {{ order.billing_address.address2 }}{% endif %}<br>{{ order.billing_address.city }}{% if order.billing_address.province != blank %}, {{ order.billing_address.province }}{% endif %} {{ order.billing_address.zip }}<br>{{ order.billing_address.country }}{% if order.billing_address.phone != blank %}<br>Tel. {{ order.billing_address.phone }}{% endif %}{%- else -%}<div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;color:#2A1C14;margin:0 0 3px;">{{ customer.name }}</div>Same as shipping{%- endif -%}</td>
</tr></table>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:18px;">
  <tr>
    <td colspan="2" style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;font-weight:700;padding:0 0 8px;border-bottom:2px solid #2A1C14;">THE PAIRS</td>
    <td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;font-weight:700;padding:0 0 8px;border-bottom:2px solid #2A1C14;text-align:right;">PRICE</td>
    <td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;font-weight:700;padding:0 0 8px;border-bottom:2px solid #2A1C14;text-align:right;">QTY</td>
    <td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;font-weight:700;padding:0 0 8px;border-bottom:2px solid #2A1C14;text-align:right;">TOTAL</td>
  </tr>
  {%- for line_item in line_items %}
  {%- assign size = '' -%}{%- assign colour = '' -%}
  {%- if line_item.variant_title != blank -%}{%- assign parts = line_item.variant_title | split: ' / ' -%}{%- assign size = parts | last -%}{%- if parts.size > 1 -%}{%- assign colour = parts | first -%}{%- endif -%}{%- endif -%}
  <tr style="page-break-inside:avoid;">
    <td style="padding:12px 14px 12px 0;border-bottom:1px solid #E2D6C6;vertical-align:middle;width:64px;">
      {%- if line_item.image != blank -%}<img src="{{ line_item.image | img_url: '160x160' }}" width="60" height="60" alt="" style="display:block;width:60px;height:60px;object-fit:cover;border:1px solid #E2D6C6;">{%- else -%}<div style="width:60px;height:60px;border:1px solid #E2D6C6;text-align:center;padding-top:19px;box-sizing:border-box;"><svg width="30" height="21" viewBox="-55 20 234 160" fill="#B0843F" xmlns="http://www.w3.org/2000/svg" style="display:block;"><g transform="skewX(-14)"><path d="M20,20 H104 A80,80 0 0 1 104,180 H-10 V144 H104 A44,44 0 0 0 104,56 H56 V128 H20 Z"/></g></svg></div>{%- endif -%}
    </td>
    <td style="padding:12px 0;border-bottom:1px solid #E2D6C6;vertical-align:middle;">
      <div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:15px;color:#2A1C14;">{{ line_item.title | split: ' - ' | first | remove: 'DAUR ' | remove: 'M.O.R.C. ' | upcase }}</div>
      <div style="margin-top:5px;">{% if colour != blank %}<span style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:9px;letter-spacing:1.5px;color:#2A1C14;border:1px solid #2A1C14;padding:2px 6px;margin-right:4px;">{{ colour | upcase }}</span>{% endif %}{% if size != blank %}<span style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:9px;letter-spacing:1.5px;color:#2A1C14;border:1px solid #2A1C14;padding:2px 6px;">{{ size | upcase }}</span>{% endif %}</div>
      {%- if line_item.sku != blank %}<div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-top:6px;">SKU {{ line_item.sku | upcase }}</div>{% endif %}
    </td>
    <td style="padding:12px 0 12px 12px;border-bottom:1px solid #E2D6C6;vertical-align:middle;text-align:right;white-space:nowrap;font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;">{% if line_item.original_price > line_item.final_price %}<span style="text-decoration:line-through;color:#7A6A5C;font-size:11px;">{{ line_item.original_price | money }}</span><br>{% endif %}{{ line_item.final_price | money }}</td>
    <td style="padding:12px 0 12px 12px;border-bottom:1px solid #E2D6C6;vertical-align:middle;text-align:right;white-space:nowrap;"><span style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:20px;">{{ line_item.quantity }}</span><span style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:10px;color:#7A6A5C;"> X</span></td>
    <td style="padding:12px 0 12px 12px;border-bottom:1px solid #E2D6C6;vertical-align:middle;text-align:right;white-space:nowrap;font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;">{{ line_item.final_line_price | money }}</td>
  </tr>
  {%- endfor %}
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:18px;page-break-inside:avoid;"><tr>
  <td style="padding:0;vertical-align:top;width:52%;padding-right:22px;">
    <div style="border:2px solid #2A1C14;padding:14px 16px;">
      <div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;">{% if order.financial_status == 'paid' %}ALREADY PAID{% else %}PAY THE RIDER{% endif %}</div>
      <div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:28px;line-height:1.1;margin:6px 0 4px;color:#2A1C14;">{% if order.financial_status == 'paid' %}{{ 0 | money }}{% else %}{{ order.total_price | money }}{% endif %}</div>
      <div style="font-size:11px;color:#7A6A5C;">{% if order.financial_status == 'paid' %}Nothing to pay on delivery.{% else %}Cash on delivery. Please keep the exact amount ready.{% endif %}</div>
    </div>
  </td>
  <td style="padding:0;vertical-align:top;width:48%;">
    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
      <tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;padding:7px 0;border-bottom:1px solid #E2D6C6;">SUBTOTAL</td><td style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#2A1C14;text-align:right;padding:7px 0;border-bottom:1px solid #E2D6C6;">{{ order.subtotal_price | money }}</td></tr>
      {%- for d in order.discount_applications %}<tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;padding:7px 0;border-bottom:1px solid #E2D6C6;">DISCOUNT{% if d.title != blank %} <span style="color:#B0843F;font-weight:700;">{{ d.title | upcase }}</span>{% endif %}</td><td style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#2A1C14;text-align:right;padding:7px 0;border-bottom:1px solid #E2D6C6;font-weight:600;">{{ d.total_allocated_amount | money | prepend: "&minus; " }}</td></tr>{%- endfor %}
      <tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;padding:7px 0;border-bottom:1px solid #E2D6C6;">DELIVERY</td><td style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#2A1C14;text-align:right;padding:7px 0;border-bottom:1px solid #E2D6C6;">{% if order.shipping_price > 0 %}{{ order.shipping_price | money }}{% else %}Free{% endif %}</td></tr>
      {%- if order.tax_price > 0 %}<tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;padding:7px 0;border-bottom:1px solid #E2D6C6;">TAX</td><td style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#2A1C14;text-align:right;padding:7px 0;border-bottom:1px solid #E2D6C6;">{{ order.tax_price | money }}</td></tr>{% endif %}
      <tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;color:#2A1C14;font-weight:700;padding:10px 0;border-top:2px solid #2A1C14;border-bottom:2px solid #2A1C14;">TOTAL</td><td style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:19px;text-align:right;padding:10px 0;border-top:2px solid #2A1C14;border-bottom:2px solid #2A1C14;">{{ order.total_price | money }}</td></tr>
      {%- if order.total_discounts > 0 %}<tr><td style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;padding:7px 0;">YOU SAVED</td><td style="font-size:12px;color:#B0843F;font-weight:600;text-align:right;padding:7px 0;">{{ order.total_discounts | money }}</td></tr>{% endif %}
    </table>
  </td>
</tr></table>

{%- if order.note != blank %}
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:16px;"><tr>
  <td style="width:4px;background-color:#B0843F;"></td>
  <td style="padding:10px 14px;border:1px solid #E2D6C6;border-left:0;font-size:12px;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:3px;">NOTES</div>{{ order.note }}</td>
</tr></table>
{%- endif %}

<div style="page-break-inside:avoid;margin-top:26px;">
<svg width="100%" height="4" viewBox="0 0 100 4" preserveAspectRatio="none" style="display:block;"><rect width="84" height="4" fill="#2A1C14"/><rect x="84" width="16" height="4" fill="#B0843F"/></svg>
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-top:14px;"><tr>
  <td style="padding:0;vertical-align:top;width:150px;padding-right:12px;"><svg width="34" height="23" viewBox="-55 20 234 160" fill="#2A1C14" xmlns="http://www.w3.org/2000/svg" style="display:block;"><g transform="skewX(-14)"><path d="M20,20 H104 A80,80 0 0 1 104,180 H-10 V144 H104 A44,44 0 0 0 104,56 H56 V128 H20 Z"/></g></svg><div style="font-family:'DAUR Display','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:700;font-size:12px;letter-spacing:1px;margin-top:8px;">THANK YOU</div><div style="font-size:10px;color:#7A6A5C;line-height:1.4;margin-top:2px;">Same local craft.<br>Zero retail markup.</div></td>
  <td style="padding:0;vertical-align:top;padding-right:8px;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2A1C14" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:6px;"><path d="M4 20l1.3-4A8 8 0 1 1 8.4 19z"/><path d="M9 9.5c.3 2 2.2 4 4.5 4.6l1.2-1.1 1.8.9"/></svg>WHATSAPP</div><div style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;color:#2A1C14;">0319 9628735</div></td><td style="padding:0;vertical-align:top;padding-right:8px;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2A1C14" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:6px;"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg>WEBSITE</div><div style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;color:#2A1C14;">daursupply.com</div></td><td style="padding:0;vertical-align:top;padding-right:8px;"><div style="font-family:'DAUR Mono',Menlo,Consolas,monospace;font-size:8.5px;letter-spacing:2px;color:#7A6A5C;font-weight:400;margin-bottom:4px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2A1C14" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:6px;"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="#2A1C14"/></svg>INSTAGRAM</div><div style="font-family:'DAUR Body','Helvetica Neue',Helvetica,Arial