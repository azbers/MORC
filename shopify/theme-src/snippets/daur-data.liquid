{%- comment -%}
  Prints the store settings and every active product for the storefront script.
  assets/daur-shopify.js turns this into the catalog. Product tags carry what
  Shopify has no field for: Men | Women | Kids, group:, badge:, silhouette:,
  swatch:<colour>=<hex> and cost:<vendor>/<kit>/<logistics>.
{%- endcomment -%}
<script>
window.DAUR_CONFIG = {
  brand: {{ shop.name | json }},
  domain: {{ request.origin | json }},
  currency: {{ settings.currency_label | default: 'Rs.' | json }},
  whatsapp: {{ settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | json }},
  supportEmail: {{ settings.support_email | default: shop.email | json }},
  marketRetail: {{ settings.market_retail | default: 12000 }},
  freeDeliveryPairs: {{ settings.free_delivery_pairs | default: 2 }},
  delivery: { fee: {{ settings.delivery_fee | default: 0 }}, days: {{ settings.delivery_days | default: '' | json }} },
  coupons: {},
  audiences: {{ settings.lines | default: 'Men' | remove: ' ' | split: ',' | json }},
  lowStockAt: {{ settings.low_stock_at | default: 2 }},
  announce: {{ settings.announcement | default: '' | json }}
};
window.DAUR_SHOPIFY = {
  param: {{ daur_param | json }},
  routes: { root: {{ routes.root_url | json }}, account: {{ routes.account_url | json }} },
  raw: [
{%- paginate collections.all.products by 250 -%}
{%- for p in collections.all.products -%}
  {
    "handle": {{ p.handle | json }}, "title": {{ p.title | json }}, "type": {{ p.type | json }}, "tags": {{ p.tags | json }},
    "created": {{ p.created_at | date: '%Y-%m-%d' | json }}, "body": {{ p.description | json }},
    {%- if product and product.id == p.id %} "seo": { "title": {{ page_title | json }}, "description": {{ page_description | default: '' | json }} },{% endif %}
    "options": [{%- for o in p.options_with_values -%}{ "name": {{ o.name | json }}, "values": {{ o.values | json }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}],
    "variants": [{%- for v in p.variants -%}{ "id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "cap": {{ v.compare_at_price | default: 0 }}, "qty": {{ v.inventory_quantity | default: 0 }}, "managed": {% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %}, "policy": {{ v.inventory_policy | json }}, "available": {{ v.available }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}],
    "images": [{%- for im in p.images -%}{ "src": {{ im | image_url: width: 1400 | json }}, "alt": {{ im.alt | default: '' | json }}, "v": {{ im.variants | map: 'id' | json }} }{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
{%- endpaginate -%}
  ]
};
</script>
