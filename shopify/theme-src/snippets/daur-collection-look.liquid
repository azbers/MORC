{%- comment -%}
  One look of Our Collection. Called by sections/daur-collection.liquid with:
  p (product), colour (text, may be blank), photo, side (images, may be blank), ai (true/false),
  label (text, may be blank), n (position, from 1), attrs (theme editor attributes, may be blank).
{%- endcomment -%}
{%- liquid
  assign v = p.selected_or_first_available_variant | default: p.variants.first
  assign want = colour | strip | downcase
  if want != blank
    for x in p.variants
      assign hit = false
      for o in x.options
        assign od = o | downcase
        if od == want
          assign hit = true
        endif
      endfor
      if hit
        assign v = x
        break
      endif
    endfor
  endif

  assign colour_opt = nil
  assign size_opt = nil
  for o in p.options_with_values
    assign on = o.name | downcase
    if on contains 'colo'
      assign colour_opt = o
    elsif on contains 'size'
      assign size_opt = o
    endif
  endfor

  assign label = label | strip
  if label == blank
    for c in p.collections
      unless c.handle == 'all' or c.handle == 'frontpage' or c.handle == 'sale'
        assign label = c.title
        break
      endunless
    endfor
  endif

  assign shot = photo
  assign shot_kind = 'model'
  if shot == blank
    assign shot = v.featured_image | default: p.featured_image
    assign shot_kind = 'product'
  endif
  assign shown_colour = v.option1
  if colour_opt
    assign ci = colour_opt.position | minus: 1
    assign shown_colour = v.options[ci]
  endif
  assign no = n | prepend: '0' | slice: -2, 2
-%}
<li class="oc-look" data-oc-handle="{{ p.handle }}" {{ attrs }}>
  <figure class="oc-fig">
    <a class="oc-frame{% if shot == blank %} is-ph{% endif %}" href="{{ v.url }}" tabindex="-1" aria-hidden="true">
      {%- if shot != blank -%}
        {{ shot | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'oc-img oc-main', alt: '', widths: '480, 720, 960, 1280, 1600', sizes: '(min-width: 900px) 40vw, 76vw' }}
      {%- else -%}
        <span class="oc-ph"><span class="oc-ph-k">Model photo needed</span><span class="oc-ph-v">{{ p.title | escape }}{% if shown_colour != blank %}, {{ shown_colour | escape }}{% endif %}</span><span class="oc-ph-s">Portrait 4:5, at least 1600 x 2000 px</span></span>
      {%- endif -%}
      {%- if side != blank -%}
        {{ side | image_url: width: 900 | image_tag: loading: 'lazy', class: 'oc-img oc-side', alt: '', widths: '360, 600, 900', sizes: '(min-width: 900px) 24vw, 50vw' }}
      {%- endif -%}
    </a>
    {%- if shot != blank -%}
    <figcaption class="oc-note">{% if shot_kind == 'product' %}Product photo{% elsif ai %}AI generated image of {{ p.title | escape }}{% else %}{{ p.title | escape }}{% endif %}</figcaption>
    {%- endif -%}
  </figure>

  <div class="oc-info">
    <p class="oc-k"><span class="oc-no">{{ no }}</span>{% if label != blank %}<span class="oc-col">{{ label | escape }}</span>{% endif %}</p>
    <h3 class="oc-name"><a href="{{ v.url }}">{{ p.title | escape }}</a></h3>
    <p class="oc-price">
      <span class="oc-now">{{ v.price | money }}</span>
      {%- if v.compare_at_price > v.price -%}
        {%- assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | floor -%}
        <s class="oc-was"><span class="sr-only">Was </span>{{ v.compare_at_price | money }}</s><span class="oc-off">{{ off }}% off</span>
      {%- endif -%}
      {%- unless p.available %}<span class="oc-sold">Sold out</span>{% endunless -%}
    </p>
    <dl class="oc-spec">
      {%- if colour_opt -%}
      <div><dt>{{ colour_opt.name | escape }}</dt><dd>{% for c in colour_opt.values %}<span class="oc-chip{% if c == shown_colour %} is-on{% endif %}">{{ c | escape }}</span>{% endfor %}</dd></div>
      {%- endif -%}
      {%- if size_opt -%}
      <div><dt>{{ size_opt.name | escape }}{% if colour_opt and colour_opt.values.size > 1 %} <span class="oc-in">in {{ shown_colour | escape }}</span>{% endif %}</dt><dd>
        {%- for s in size_opt.values -%}
          {%- liquid
            assign ok = false
            for x in p.variants
              if x.available and x.options contains s
                if colour_opt == nil
                  assign ok = true
                elsif x.options contains shown_colour
                  assign ok = true
                endif
              endif
            endfor
          -%}
          <span class="oc-size{% unless ok %} is-out{% endunless %}">{{ s | remove: 'EU ' | escape }}{% unless ok %}<span class="sr-only"> sold out</span>{% endunless %}</span>
        {%- endfor -%}
      </dd></div>
      {%- endif -%}
    </dl>
    <div class="oc-acts">
      <a class="oc-cta" href="{{ v.url }}">Shop This Look<span class="sr-only">: {{ p.title | escape }}</span> <span aria-hidden="true">&rarr;</span></a>
      <button class="oc-like" type="button" data-wish="{{ p.handle }}" data-oc-like aria-pressed="false" hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2z" fill="var(--oc-heart, none)" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span class="oc-like-t">Like</span><span class="sr-only"> {{ p.title | escape }}</span></button>
    </div>
  </div>
</li>
