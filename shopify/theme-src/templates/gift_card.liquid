{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Gift card | {{ shop.name }}</title>{{ 'styles.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head>
<body><main class="wrap daur-plain"><h1>{{ gift_card.balance | money }}</h1><p>Gift card code: <b class="mono">{{ gift_card.code | format_code }}</b></p>{% if gift_card.expired %}<p>This gift card has expired.</p>{% endif %}<p><a class="btn volt" href="{{ shop.url }}">Shop now</a></p></main></body></html>
