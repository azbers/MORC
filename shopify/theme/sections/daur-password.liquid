<div class="wrap daur-plain daur-pass">
  <a class="logo" href="{{ routes.root_url }}" aria-label="DAUR Supply home"><svg class="wm" viewBox="-22 0 462 100" fill="currentColor" aria-hidden="true"><g transform="skewX(-12)" fill-rule="evenodd"><path d="M0,0 H50 A50,50 0 0 1 50,100 H0 Z M27,25 H50 A25,25 0 0 1 50,75 H27 Z"/><path transform="translate(110 0)" d="M0,100 L36,0 H72 L108,100 H79 L54,28 L29,100 Z"/><path transform="translate(226 0)" d="M0,0 H27 V52 A23,23 0 0 0 73,52 V0 H100 V52 A50,48 0 0 1 0,52 Z"/><path transform="translate(340 0)" d="M0,0 H62 A31,31 0 0 1 80,56 L102,100 H71 L51,62 H27 V100 H0 Z M27,20 H61 A11,11 0 0 1 61,42 H27 Z"/></g></svg><small>SUPPLY</small></a>
  <h1>{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank %}<p class="aside">{{ shop.password_message }}</p>{% endif %}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="track-one"><div class="f-ic"><input type="password" name="password" placeholder="Store password" aria-label="Store password" autocomplete="current-password"></div><button class="btn volt" type="submit">Enter</button></div>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password page", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Drop 01 is loading." } ] }
{% endschema %}
