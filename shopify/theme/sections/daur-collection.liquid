{%- comment -%}
  Our Collection: an editorial showcase of models wearing DAUR pairs, for the home page.
  Looks come from two places, in this order:
  1. Look blocks in the theme editor (product, colour worn, model photo, side pose), in block order.
  2. Every other product in the chosen collection (default: all products), using the model photos
     set on the product itself: metafields custom.model_photo and custom.model_side_photo.
  Name, collection, colours, sizes, price and link always come from the product, so a price or
  stock change in Shopify shows here without editing the section.
  assets/daur-collection.js places it under the hero and lets visitors move through the looks
  sideways; the page itself always scrolls freely. With reduced motion, Lite mode or no script,
  the looks show as a plain sequence of photographs.
{%- endcomment -%}
{%- liquid
  assign src = section.settings.collection | default: collections.all
  assign used = ','
  assign looks = 0
  for block in section.blocks
    if block.settings.product != blank
      assign key = ',' | append: block.settings.product.handle | append: ','
      unless used contains key
        assign used = used | append: block.settings.product.handle | append: ','
        assign looks = looks | plus: 1
      endunless
    endif
  endfor
  if section.settings.show_all
    for p in src.products limit: 24
      assign key = ',' | append: p.handle | append: ','
      unless used contains key
        assign looks = looks | plus: 1
      endunless
    endfor
  endif
-%}
{%- if looks > 0 or request.design_mode -%}
<section class="oc saddle" data-oc aria-labelledby="oc-h-{{ section.id }}">
  <header class="oc-head">
    <p class="oc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="oc-title" id="oc-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank %}<p class="oc-intro">{{ section.settings.intro | escape }}</p>{% endif -%}
  </header>
  <div class="oc-stage">
    {%- if looks == 0 -%}
    <p class="oc-empty">No looks yet. Add a Look block, or turn on "Show every product". This note shows only in the editor.</p>
    {%- endif -%}

    <ol class="oc-looks" role="list" aria-label="{{ section.settings.eyebrow | escape }}">
    {%- assign n = 0 -%}
    {%- assign done = ',' -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      {%- assign key = ',' | append: p.handle | append: ',' -%}
      {%- if done contains key -%}{%- continue -%}{%- endif -%}
      {%- assign done = done | append: p.handle | append: ',' -%}
      {%- assign n = n | plus: 1 -%}
      {%- assign photo = block.settings.photo | default: p.metafields.custom.model_photo.value -%}
      {%- assign side = block.settings.side_photo | default: p.metafields.custom.model_side_photo.value -%}
      {%- capture attrs -%}{{ block.shopify_attributes }}{%- endcapture -%}
      {%- render 'daur-collection-look', p: p, colour: block.settings.colour, photo: photo, side: side, ai: block.settings.ai_image, label: block.settings.label, n: n, attrs: attrs -%}
    {%- endfor -%}
    {%- if section.settings.show_all -%}
      {%- for p in src.products limit: 24 -%}
        {%- assign key = ',' | append: p.handle | append: ',' -%}
        {%- if done contains key -%}{%- continue -%}{%- endif -%}
        {%- assign done = done | append: p.handle | append: ',' -%}
        {%- assign n = n | plus: 1 -%}
        {%- liquid
          assign ai = true
          if p.metafields.custom.model_photo_ai.value == false
            assign ai = false
          endif
        -%}
        {%- render 'daur-collection-look', p: p, colour: '', photo: p.metafields.custom.model_photo.value, side: p.metafields.custom.model_side_photo.value, ai: ai, label: '', n: n, attrs: '' -%}
      {%- endfor -%}
    {%- endif -%}
    </ol>
    <div class="oc-panel" aria-live="polite"></div>

    {%- if looks > 1 -%}
    <div class="oc-ctl" hidden>
      <button class="oc-btn" type="button" data-oc-go="-1" aria-label="Previous look">&larr;</button>
      <span class="oc-count"><b>01</b> / {{ looks | prepend: '0' | slice: -2, 2 }}</span>
      <button class="oc-btn" type="button" data-oc-go="1" aria-label="Next look">&rarr;</button>
      <span class="oc-bar" aria-hidden="true"><i></i></span>
    </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Our Collection",
  "tag": "div",
  "class": "oc-section",
  "limit": 1,
  "max_blocks": 24,
  "settings": [
    { "type": "paragraph", "content": "Models wearing DAUR pairs, shown under the home page hero. Visitors swipe, drag or use the arrows to bring each look to the centre; the page itself always scrolls freely. With reduced motion or Lite mode the looks show as a simple list." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn, not displayed." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "One pair per look, styled on foot. Swipe or use the arrows to bring the next pair into the light." },
    { "type": "header", "content": "Products shown" },
    { "type": "checkbox", "id": "show_all", "label": "Show every product", "default": true, "info": "After the Look blocks, every other product in the collection below is shown, using the model photos set on the product (Products > the product > Metafields: Model photo, Model side or seated pose)." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for all products. Up to 24 are shown." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "paragraph", "content": "Use a block to fix the order of a pair, show a particular colour, or use a different photo from the one on the product." },
        { "type": "product", "id": "product", "label": "Product", "info": "Name, collection, colours, sizes, price and the Shop This Look link come from this product." },
        { "type": "text", "id": "colour", "label": "Colour worn", "info": "Type it exactly as the product's colour option, for example Black Waxed. The price, sizes in stock and link follow this colour. Leave empty for the first available colour." },
        { "type": "image_picker", "id": "photo", "label": "Model photo", "info": "Portrait 4:5, at least 1600 x 2000 px. Leave empty to use the Model photo set on the product, then the product photo." },
        { "type": "image_picker", "id": "side_photo", "label": "Side or seated pose (optional)", "info": "Shown while this look waits beside the centre. Portrait 4:5." },
        { "type": "checkbox", "id": "ai_image", "label": "Photo is AI generated", "default": true, "info": "Adds the caption \"AI generated image of\" and the product name, so visitors are not misled." },
        { "type": "text", "id": "label", "label": "Collection label (optional)", "info": "Leave empty to use the product's first collection." }
      ]
    }
  ],
  "presets": [ { "name": "Our Collection" } ]
}
{% endschema %}
