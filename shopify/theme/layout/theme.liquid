<!doctype html>
{%- liquid
  # which storefront view draws this address
  assign daur_page = 'page'
  assign daur_param = ''
  case template.name
    when 'index'
      assign daur_page = 'home'
    when 'product'
      assign daur_page = 'product'
      assign daur_param = product.handle
    when 'collection'
      assign daur_page = 'shop'
      # collection handle : storefront view, so each style has an address of its own
      assign known = 'men:men,women:women,kids:kids,sale:sale,new:new,sneakers:sneakers,leather-shoes:leather,casual:hybrids' | split: ','
      for pair in known
        assign kv = pair | split: ':'
        if collection.handle == kv[0]
          assign daur_param = kv[1]
        endif
      endfor
    when 'list-collections'
      assign daur_page = 'shop'
    when 'cart'
      assign daur_page = 'cart'
    when 'page'
      assign views = 'manifesto:manifesto,contract:contract,track:track,liked:wishlist,alerts:list,feed:feed,policies:policies' | split: ','
      for pair in views
        assign kv = pair | split: ':'
        if page.handle == kv[0]
          assign daur_page = kv[1]
        endif
      endfor
  endcase
  # the home page title and description are theme settings (Theme settings > Search)
  assign daur_title = page_title
  assign daur_desc = page_description
  if template.name == 'index'
    assign daur_title = settings.seo_home_title | default: page_title
    assign daur_desc = settings.seo_home_description | default: page_description
  endif
-%}
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ daur_title }}{% unless daur_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{%- if daur_desc %}<meta name="description" content="{{ daur_desc | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.google_verification != blank %}<meta name="google-site-verification" content="{{ settings.google_verification | escape }}">{% endif %}
<meta name="theme-color" content="#F5EEE4">
<script>try{var d=document.documentElement,n=navigator;if(localStorage.getItem('daur.theme')==='dark')d.dataset.theme='dark';if(localStorage.getItem('daur.grid')==='1')d.classList.add('grid-1')}catch(e){}try{if(/Android/i.test(n.userAgent)&&((n.deviceMemory||8)<=4||(n.hardwareConcurrency||8)<=4)||(n.connection&&n.connection.saveData))d.classList.add('lite')}catch(e){}</script>
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:title" content="{{ daur_title | escape }}">
<meta property="og:description" content="{{ daur_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if template.name == 'product' and product.featured_image %}
<meta property="og:type" content="product">
<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- else %}
<meta property="og:type" content="website">
{%- if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif %}
{%- endif %}
<meta property="og:locale" content="en_PK">
<meta name="twitter:card" content="summary_large_image">
{%- if settings.favicon %}
<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">
{%- else %}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%232A1C14'/%3E%3Cg transform='translate(16.6 16) scale(.1) translate(-62 -100) skewX(-14)' fill='%23F5EEE4'%3E%3Cpath d='M20,20 H104 A80,80 0 0 1 104,180 H-10 V144 H104 A44,44 0 0 0 104,56 H56 V128 H20 Z'/%3E%3C/g%3E%3C/svg%3E">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{%- comment -%} fonts load without holding up the first paint; the system fallbacks show until they arrive {%- endcomment -%}
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
<link rel="preload" as="image" href="{{ 'leather.jpg' | asset_url }}">
{{ 'styles.css' | asset_url | stylesheet_tag }}
{{ 'daur-theme.css' | asset_url | stylesheet_tag }}
<noscript><style>.daur-plain{visibility:visible!important;animation:none!important}#app::after{display:none!important}</style></noscript>
{% render 'daur-ld', product: product, collection: collection %}
{{ content_for_header }}
</head>
<body data-page="{{ daur_page }}">
<main id="app" tabindex="-1">{{ content_for_layout }}</main>
{% render 'daur-data', product: product, daur_param: daur_param %}
<script src="{{ 'daur-shopify.js' | asset_url }}" defer></script>
<script src="{{ 'shoe.js' | asset_url }}" defer></script>
<script src="{{ 'icons.js' | asset_url }}" defer></script>
<script src="{{ 'kicks.js' | asset_url }}" defer></script>
<script src="{{ 'pile.js' | asset_url }}" defer></script>
{%- if daur_page == 'policies' %}<script src="{{ 'polart.js' | asset_url }}" defer></script>{% endif %}
<script src="{{ 'social.js' | asset_url }}" defer></script>
<script src="{{ 'alive.js' | asset_url }}" defer></script>
<script src="{{ 'app.js' | asset_url }}" defer></script>
</body>
</html>
