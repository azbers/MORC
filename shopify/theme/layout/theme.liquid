<!doctype html>
{%- liquid
  # which storefront view draws this address
  assign daur_page = 'page'
  assign daur_param = ''
  case template.name
    when 'index'
      assign daur_page = 'home'
    when 'product'
      assign daur_page = 'product'
      assign daur_param = product.handle
    when 'collection'
      assign daur_page = 'shop'
      # collection handle : storefront view, so each style has an address of its own
      assign known = 'men:men,women:women,kids:kids,sale:sale,new:new,sneakers:sneakers,leather-shoes:leather,casual:hybrids' | split: ','
      for pair in known
        assign kv = pair | split: ':'
        if collection.handle == kv[0]
          assign daur_param = kv[1]
        endif
      endfor
    when 'list-collections'
      assign daur_page = 'shop'
    when 'cart'
      assign daur_page = 'cart'
    when 'search'
      assign daur_page = 'search'
    when '404'
      assign daur_page = 'notfound'
    when 'page'
      assign views = 'manifesto:manifesto,contract:contract,track:track,liked:wishlist,alerts:list,feed:feed,policies:policies,about:about,contact:contact,offers:offers,runway:runway,giving:giving,gifts:gifts' | split: ','
      for pair in views
        assign kv = pair | split: ':'
        if page.handle == kv[0]
          assign daur_page = kv[1]
        endif
      endfor
  endcase
  # the home page title and description are theme settings (Theme settings > Search)
  assign daur_title = page_title
  assign daur_desc = page_description
  if template.name == 'index'
    # a fixed fallback, so the home page never goes out with only the shop name and no description
    assign daur_title = settings.seo_home_title | default: "DAUR Supply | Men's Shoes & Leather Sneakers Online in Pakistan"
    assign daur_desc = settings.seo_home_description | default: "Shop men's leather sneakers, formal shoes, chelsea boots and casual slip ons from DAUR Supply, crafted in Pakistan. Cash on Delivery nationwide and free delivery on 2 pairs."
  endif
  if daur_desc == blank
    assign daur_desc = shop.description | default: settings.seo_home_description | default: "DAUR Supply: men's leather shoes and sneakers crafted in Pakistan. Cash on Delivery to every city in Pakistan." 
  endif
-%}
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ daur_title }}{% unless daur_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{%- if daur_desc %}<meta name="description" content="{{ daur_desc | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.clarity_id != blank %}
{%- comment -%} Clarity loads after the page has finished loading, so it never competes with the first screen; calls made before then are queued {%- endcomment -%}
<script>(function(c,l,a,r,i){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};function go(){var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";l.head.appendChild(t)}function later(){(c.requestIdleCallback||function(f){setTimeout(f,1500)})(go,{timeout:4000})}if(l.readyState==='complete')later();else c.addEventListener('load',later)})(window,document,"clarity","script",{{ settings.clarity_id | strip | json }});</script>
{%- endif %}
{%- if settings.google_verification != blank %}<meta name="google-site-verification" content="{{ settings.google_verification | escape }}">{% endif %}
{%- comment -%} utility pages carry no search value: the bag, liked pairs, order tracking and the retired alert list {%- endcomment -%}
{%- liquid
  assign daur_noindex = false
  if template.name == '404' or template.name == 'search' or template.name == 'cart' or template.directory == 'customers'
    assign daur_noindex = true
  elsif template.name == 'page'
    if page.handle == 'liked' or page.handle == 'track' or page.handle == 'alerts'
      assign daur_noindex = true
    endif
  endif
-%}
{%- if daur_noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="theme-color" content="#FFFFFF">
<script>try{var d=document.documentElement,n=navigator;if(localStorage.getItem('daur.theme')==='dark')d.dataset.theme='dark';if(localStorage.getItem('daur.grid')==='1')d.classList.add('grid-1')}catch(e){}try{if(/Android/i.test(n.userAgent)&&((n.deviceMemory||8)<=4||(n.hardwareConcurrency||8)<=4)||(n.connection&&n.connection.saveData))d.classList.add('lite')}catch(e){}</script>
{%- comment -%} Link previews (WhatsApp, Facebook, Instagram DMs, X): every page gets a title, a description and a 1200 x 630 image. Image order: product photo, article photo, the page's own social image, the Social sharing image in Online Store > Preferences, the theme share image setting, then assets/daur-share.jpg. {%- endcomment -%}
{%- liquid
  assign og_desc = daur_desc | default: shop.description | default: settings.seo_home_description | strip_html | strip_newlines | truncate: 200
  assign og_has = false
  if template.name == 'product' and product.featured_image
    assign og_img = product.featured_image
    assign og_has = true
  elsif template.name == 'article' and article.image
    assign og_img = article.image
    assign og_has = true
  elsif page_image
    assign og_img = page_image
    assign og_has = true
  elsif settings.share_image != blank
    assign og_img = settings.share_image
    assign og_has = true
  endif
  if og_has
    assign og_img_url = og_img | image_url: width: 1200, height: 630, crop: 'center', format: 'pjpg' | prepend: 'https:'
    assign og_img_alt = og_img.alt | default: daur_title
  else
    assign og_img_url = 'daur-share.jpg' | asset_url | prepend: 'https:'
    assign og_img_alt = shop.name | append: " men's leather shoes, Cash on Delivery across Pakistan"
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:title" content="{{ daur_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if template.name == 'product' %}
<meta property="og:type" content="product">
<meta property="product:price:amount" content="{{ product.price | money_without_currency | remove: ',' }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif template.name == 'article' %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}">
{%- for t in article.tags %}<meta property="article:tag" content="{{ t | escape }}">{%- endfor %}
{%- else %}
<meta property="og:type" content="website">
{%- endif %}
<meta property="og:image" content="{{ og_img_url }}">
<meta property="og:image:secure_url" content="{{ og_img_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ og_img_alt | escape }}">
<meta property="og:locale" content="en_PK">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ daur_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
<meta name="twitter:image" content="{{ og_img_url }}">
{%- comment -%} Google shows a site icon only from a real, crawlable file whose size is a multiple of 48 px; an inline data: icon is ignored {%- endcomment -%}
{%- if settings.favicon %}
<link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192, crop: 'center' }}">
<link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}">
{%- else %}
<link rel="icon" type="image/png" sizes="192x192" href="{{ 'daur-favicon-192.png' | asset_url }}">
<link rel="icon" type="image/svg+xml" href="{{ 'daur-favicon.svg' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'daur-favicon-180.png' | asset_url }}">
{%- endif %}
{%- comment -%} the three brand fonts are served from the theme itself (no Google Fonts round trips); the heading font is fetched first {%- endcomment -%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'font-grotesk.woff2' | asset_url }}" crossorigin>
{{ 'styles.css' | asset_url | stylesheet_tag }}
{%- comment -%} the small Shopify only stylesheet is printed inline, so it is not a second file holding up the first paint {%- endcomment -%}
<style>{% render 'daur-theme-css' %}</style>
<noscript><style>.daur-plain{visibility:visible!important;animation:none!important}#app::after{display:none!important}</style></noscript>
{% render 'daur-ld', product: product, collection: collection, blog: blog, article: article, page: page %}
{{ content_for_header }}
</head>
<body data-page="{{ daur_page }}">
{% render 'daur-loader' %}
<div class="hdr-ph" aria-hidden="true"></div>
<main id="app" tabindex="-1">{{ content_for_layout }}</main>
{% render 'daur-data', product: product, daur_param: daur_param %}
{%- if settings.test_photos and theme.role != 'main' %}{% render 'daur-test-photos' %}{% endif %}
<script src="{{ 'daur-shopify.js' | asset_url }}" defer></script>
<script src="{{ 'shoe.js' | asset_url }}" defer></script>
<script src="{{ 'icons.js' | asset_url }}" defer></script>
<script src="{{ 'kicks.js' | asset_url }}" defer></script>
<script src="{{ 'pile.js' | asset_url }}" defer></script>
{%- if daur_page == 'policies' or daur_page == 'contact' %}<script src="{{ 'polart.js' | asset_url }}" defer></script>{% endif %}
<script src="{{ 'social.js' | asset_url }}" defer></script>
<script src="{{ 'alive.js' | asset_url }}" defer></script>
<script src="{{ 'app.js' | asset_url }}" defer></script>
</body>
</html>
